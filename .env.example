# 复制为仓库根目录 .env 后填写（.env 已 gitignore）
# cp .env.example .env

# —— 本地 JEVOS（Permission Gateway 第四层，默认 127.0.0.1:8017）——
# AVATAR_JEVOS_URL=http://127.0.0.1:8017
# AVATAR_JEVOS_TIMEOUT_SEC=20

# —— 引擎默认上下文窗口（Codex/Cursor 估算分母；Claude 也可作 stream 回退）——
# AVATAR_CONTEXT_WINDOW_CLAUDE=1000000
# 仅对确实具有 1M 上下文的 Claude 模型使用此默认值；其他模型请覆盖实际窗口。
# AVATAR_CONTEXT_WINDOW_CODEX=200000
# AVATAR_CONTEXT_WINDOW_CURSOR=200000

# —— 数字员工头像 OSS（阿里云）——
AVATAR_OSS_ENDPOINT=oss-cn-qingdao.aliyuncs.com
AVATAR_OSS_ACCESS_KEY_ID=
AVATAR_OSS_ACCESS_KEY_SECRET=
AVATAR_OSS_BUCKET=digital-employee-qd
AVATAR_OSS_PREFIX=avatars/
# 公网访问根（CNAME），拼接 object 为最终 avatar_url
# 须可被浏览器直连（HTTPS 证书主机名匹配）。自定义 CNAME 未绑证时请用官方桶域名：
AVATAR_OSS_PUBLIC_BASE=https://digital-employee-qd.oss-cn-qingdao.aliyuncs.com
